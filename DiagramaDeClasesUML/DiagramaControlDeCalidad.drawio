                <mxCell id="note_invariants" value="&lt;b&gt;REGLAS DE NEGOCIO E INVARIANTES:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Analista:&lt;/b&gt; Formato código &lt;code&gt;QA-\d{2}&lt;/code&gt; (ej: QA-02). Fecha válida.&lt;br/&gt;• &lt;b&gt;Lote:&lt;/b&gt; Formato &lt;code&gt;L-\d{4}-[A-Z]&lt;/code&gt; (ej: L-2026-A).&lt;br/&gt;• &lt;b&gt;Sonda:&lt;/b&gt; Solo mide si &lt;code&gt;isCalibrada() == true&lt;/code&gt;.&lt;br/&gt;• &lt;b&gt;Criterio Térmico:&lt;/b&gt; &lt;code&gt;temp &amp;lt;= 4.0 °C&lt;/code&gt; &amp;rarr; &lt;font color=&quot;#059669&quot;&gt;&lt;b&gt;APTO&lt;/b&gt;&lt;/font&gt;; &lt;code&gt;&amp;gt; 4.0 °C&lt;/code&gt; &amp;rarr; &lt;font color=&quot;#DC2626&quot;&gt;&lt;b&gt;NO APTO&lt;/b&gt;&lt;/font&gt;.&lt;br/&gt;• &lt;b&gt;Fail-Fast:&lt;/b&gt; Datos nulos/vacíos lanzan &lt;code&gt;IllegalArgumentException&lt;/code&gt;." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;size=15;spacingTop=6;spacingLeft=8;align=left;verticalAlign=top;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="770" width="580" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="note_legend" value="&lt;b&gt;NOTACIÓN DE RELACIONES UML:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Composición (◆):&lt;/b&gt; &lt;code&gt;FormularioControlCalidad&lt;/code&gt; contiene &lt;code&gt;Muestra&lt;/code&gt; [1 &amp;rarr; 0..*].&lt;br/&gt;• &lt;b&gt;Agregación (◇):&lt;/b&gt; &lt;code&gt;FormularioControlCalidad&lt;/code&gt; referencia &lt;code&gt;Analista&lt;/code&gt; [1 &amp;rarr; 1].&lt;br/&gt;• &lt;b&gt;Asociación simple (&amp;rarr;):&lt;/b&gt; &lt;code&gt;Muestra&lt;/code&gt; evalúa &lt;code&gt;Producto&lt;/code&gt; [* &amp;rarr; 1].&lt;br/&gt;• &lt;b&gt;Dependencia (- - &amp;gt;):&lt;/b&gt; &lt;code&gt;Main&lt;/code&gt; orquesta las instancias y mediciones." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=11;size=15;spacingTop=6;spacingLeft=8;align=left;verticalAlign=top;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="690" y="780" width="580" height="140" as="geometry"/>
                </mxCell>
